{
  "name": "mabiz",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "pnpm dev:metro",
    "dev:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 EXPO_PORT=8081 npx expo start --web --port 8081",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:journeys": "playwright test e2e/six-journeys.spec.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "qr": "node scripts/generate_qr.mjs",
    "desktop:dev": "vite --config desktop/vite.config.ts",
    "desktop:build": "vite build --config desktop/vite.config.ts",
    "desktop:preview": "vite preview --config desktop/vite.config.ts"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
