import { Ionicons } from "@expo/vector-icons";
import { router } from "expo-router";
import { useState } from "react";
import { Alert, Platform, Pressable, Share, Switch, Text, View } from "react-native";
import { ActionTile, Button, ConfirmModal, LocalNote, Page, SectionTitle, TopBar, styles } from "@/components/biz-ui";
import { useAppStore } from "@/hooks/use-app-store";
import { t } from "@/i18n/translations";
import { useThemeContext } from "@/lib/theme-provider";
import { colors } from "@/theme/tokens";
import type { AppearanceMode } from "@/types/domain";
import { useMabizServices, useMabizServiceMode } from "@/lib/services/service-provider";

type IconName = React.ComponentProps<typeof Ionicons>["name"];
type Item = { title: string; detail?: string; icon: IconName; route?: string; onPress?: () => void };

function feedback(message: string) {
  if (Platform.OS === "web") window.alert(message);
  else Alert.alert("Mabiz", message);
}

function AppearanceSelector({
  appearance,
  language,
  onChange,
  disabled,
}: {
  appearance: AppearanceMode;
  language: "en" | "sw";
  onChange: (mode: AppearanceMode) => void;
  disabled: boolean;
}) {
  return (
    <View style={[styles.actionTile, { flexDirection: "column", alignItems: "stretch" }]}>
      <Text style={styles.cardTitle}>{t("appearance", language)}</Text>
      <Text style={styles.caption}>{t("appearanceDetail", language)}</Text>
      <View style={styles.row}>
        {(["light", "dark"] as const).map((mode) => {
          const selected = appearance === mode;
          const label = mode === "light" ? t("lightMode", language) : t("darkMode", language);
          return (
            <Pressable
              key={mode}
              accessibilityRole="button"
              accessibilityLabel={label}
              accessibilityState={{ selected, disabled }}
              disabled={disabled}
              onPress={() => onChange(mode)}
              style={[
                styles.themeOption,
                selected && { backgroundColor: colors.emeraldTint, borderColor: colors.emerald },
                disabled && { opacity: 0.55 },
              ]}
            >
              <Ionicons
                name={mode === "light" ? "sunny-outline" : "moon-outline"}
                size={18}
                color={selected ? colors.emeraldDark : colors.muted}
              />
              <Text style={[styles.body, selected && { color: colors.emeraldDark, fontWeight: "700" }]}>{label}</Text>
            </Pressable>
          );
        })}
      </View>
    </View>
  );
}

export default function MenuScreen() {
  const app = useAppStore();
  const services = useMabizServices();
  const serviceMode = useMabizServiceMode();
  const { setColorScheme } = useThemeContext();
  const [logoutConfirm, setLogoutConfirm] = useState(false);
  const language = app.settings.language;

  const signOut = async () => {
    const result = await services.auth.logout();
    await app.setAuthenticated(false);
    feedback(
      result.ok
        ? "You are signed out."
        : "The server may not have received logout, but this device cleared its session. Please sign in again if needed."
    );
    router.replace("/auth");
  };

  const selectAppearance = (appearance: AppearanceMode) => {
    setColorScheme(appearance);
    app.updateSettings({ appearance });
  };

  const appearanceSelector = (
    <AppearanceSelector
      appearance={app.settings.appearance}
      language={language}
      onChange={selectAppearance}
      disabled={!app.hasHydrated}
    />
  );

  const switchRow = (label: string, detail: string, value: boolean, onValueChange: (value: boolean) => void) => (
    <View style={styles.actionTile}>
      <View style={{ flex: 1 }}>
        <Text style={styles.cardTitle}>{label}</Text>
        <Text style={styles.caption}>{detail}</Text>
      </View>
      <Switch
        value={value}
        onValueChange={onValueChange}
        trackColor={{ false: colors.border, true: colors.emerald }}
        thumbColor={colors.white}
      />
    </View>
  );

  const renderItems = (items: Item[]) =>
    items.map((item) => (
      <ActionTile
        key={item.title}
        title={item.title}
        detail={item.detail}
        icon={item.icon}
        onPress={item.onPress ?? (() => router.push(item.route as never))}
      />
    ));

  /* ------------------------- signed-out state ------------------------- */
  if (!app.isAuthenticated) {
    return (
      <Page>
        <TopBar title="Menu" back />
        <LocalNote text={t("appearanceLocalOnly", language)} />
        {appearanceSelector}
        <ActionTile
          title={t("signIn", language)}
          detail={t("accountSettingsRequireSignIn", language)}
          icon="log-in-outline"
          onPress={() => router.push("/auth/login")}
        />
      </Page>
    );
  }

  /* ------------------------------ sections ------------------------------ */
  const account: Item[] = [
    { title: "Personal details", detail: "Name, username, bio, town & county", icon: "person-circle-outline", route: "/edit-profile" },
    { title: "Password and security", detail: "Request a code to change your password", icon: "key-outline", route: "/auth/forgot-password" },
    { title: "Export your data", detail: "Create a local JSON export of demo profile and activity", icon: "download-outline", route: "/data-export" },
    { title: "Delete account", detail: "Remove this local demo profile and stored state", icon: "trash-outline", route: "/delete-account" },
  ];

  const howYouUse: Item[] = [
    { title: "Saved", detail: `${app.savedPosts.length + app.savedStories.length} posts & stories saved`, icon: "bookmark-outline", route: "/saved" },
    { title: "Saved businesses", detail: "Places and founders to revisit", icon: "heart-outline", route: "/saved-businesses" },
    { title: "Archive & drafts", detail: `${app.drafts.length} drafts stored on this device`, icon: "archive-outline", route: "/drafts" },
    { title: "Your activity", detail: "Recently viewed posts, profiles & interactions", icon: "time-outline", route: "/recently-viewed" },
    { title: "Business ideas & opportunities", detail: "Saved opportunities and founder resources", icon: "bulb-outline", route: "/opportunities" },
    { title: "Notifications", detail: "View alerts and activity updates", icon: "notifications-outline", route: "/notifications" },
  ];

  const subscription: Item[] = [
    { title: "Subscriptions & Mabiz Pro", detail: "Manage creator and business verification plans", icon: "card-outline", route: "/subscriptions" },
  ];

  const whoCanSee: Item[] = [
    { title: "Profile privacy", detail: "Account visibility and data controls", icon: "lock-closed-outline", route: "/privacy" },
    { title: "Blocked", detail: "Manage accounts you have restricted or blocked", icon: "ban-outline", route: "/privacy/blocked" },
    { title: "Hide story", detail: "Control who can view your business & personal stories", icon: "eye-off-outline", route: "/privacy/hide-story" },
  ];

  const interact: Item[] = [
    { title: "Messages and story replies", detail: "Control who can message you or reply to stories", icon: "chatbubble-ellipses-outline", route: "/privacy" },
    { title: "Tags and mentions", detail: "Choose who can tag or @mention your profile", icon: "at-outline", route: "/privacy/tags-mentions" },
    { title: "Comments", detail: "Manage comment filters and permissions", icon: "chatbox-outline", route: "/privacy/comments" },
    { title: "Sharing", detail: "Allow others to reshare your posts and stories", icon: "share-social-outline", route: "/privacy/sharing" },
    { title: "Followers & following", detail: "People and businesses you connect with", icon: "people-outline", route: "/followers" },
    {
      title: "Follow and invite friends",
      detail: "Connect with founders and invite contacts to Mabiz",
      icon: "person-add-outline",
      onPress: () => {
        void Share.share({
          message: `Join me on Mabiz (@${app.user.username}) to connect with local businesses and founders!`,
        });
      },
    },
  ];

  const deviceAndAccess: Item[] = [
    { title: "Device permissions", detail: "Camera, photos, location and notifications access", icon: "phone-portrait-outline", route: "/device-permissions" },
    { title: "Accessibility", detail: "Text sizing, contrast and motion preferences", icon: "accessibility-outline", route: "/accessibility" },
  ];

  const support: Item[] = [
    { title: "Help", detail: "Help centre & community guidelines", icon: "help-circle-outline", route: "/help" },
    { title: "Privacy Centre", detail: "Learn how Mabiz protects and manages your information", icon: "shield-checkmark-outline", route: "/privacy" },
    { title: "Profile status", detail: "Check account standing and community guideline status", icon: "checkmark-circle-outline", route: "/profile-status" },
    { title: "About", detail: "Version 1.0 · Mabiz information & terms", icon: "information-circle-outline", route: "/about" },
  ];

  return (
    <Page>
      <TopBar title="Menu" back />
      <LocalNote text="Preferences and account state are stored on this device." />

      {/* 1. Account */}
      <SectionTitle title="Account" />
      {renderItems(account)}

      {/* 2. How you use the app */}
      <SectionTitle title="How you use the app" />
      {renderItems(howYouUse)}
      {serviceMode === "api"
        ? renderItems([
            {
              title: "Notification delivery preferences",
              detail: "Manage in-app, activity and Expo push settings for your account",
              icon: "options-outline",
              route: "/notification-settings",
            },
          ])
        : switchRow(
            "Sample notifications",
            "Local demo preference; no push device is registered in mock mode",
            app.settings.notifications,
            (value) => app.updateSettings({ notifications: value })
          )}
      {renderItems([
        { title: "Settings", detail: "All app preferences in one place", icon: "settings-outline", route: "/settings" },
      ])}

      {/* 3. Subscription */}
      <SectionTitle title="Subscription" />
      {renderItems(subscription)}

      {/* 4. Who can see your content */}
      <SectionTitle title="Who can see your content" />
      {renderItems(whoCanSee)}

      {/* 5. How others can interact with you */}
      <SectionTitle title="How others can interact with you" />
      {renderItems(interact)}

      {/* 6. Your app and media */}
      <SectionTitle title="Your app and media" />
      {appearanceSelector}
      <View style={styles.actionTile}>
        <View style={{ flex: 1 }}>
          <Text style={styles.cardTitle}>{t("language", language)}</Text>
          <Text style={styles.caption}>English / Kiswahili · more markets can be added centrally</Text>
        </View>
        <View style={styles.row}>
          <Button
            title="English"
            small
            variant={language === "en" ? "soft" : "outline"}
            onPress={() => app.updateSettings({ language: "en" })}
          />
          <Button
            title="Kiswahili"
            small
            variant={language === "sw" ? "soft" : "outline"}
            onPress={() => app.updateSettings({ language: "sw" })}
          />
        </View>
      </View>
      {switchRow(
        "Reduced data",
        "Use fewer background loads and defer media when available",
        app.settings.reducedData,
        (value) => app.updateSettings({ reducedData: value })
      )}
      {switchRow(
        "Video autoplay",
        "Videos start only when you choose them by default",
        app.settings.autoplayVideos,
        (value) => app.updateSettings({ autoplayVideos: value })
      )}
      {renderItems(deviceAndAccess)}

      {/* 7. More info and support */}
      <SectionTitle title="More info and support" />
      {renderItems(support)}
      <Button title="Log out" icon="log-out-outline" variant="outline" onPress={() => setLogoutConfirm(true)} />
      <Text style={styles.caption}>Signing out ends your session on this device and, when reachable, on the server.</Text>

      <ConfirmModal
        visible={logoutConfirm}
        title="Sign out?"
        detail="You can browse public businesses while signed out. Interactions that require authentication will ask you to sign in again."
        confirmLabel="Sign out"
        onCancel={() => setLogoutConfirm(false)}
        onConfirm={() => {
          setLogoutConfirm(false);
          void signOut();
        }}
      />
    </Page>
  );
}