# Public API endpoint settings only. No signing secrets, provider keys or database credentials belong here.
EXPO_PUBLIC_API_MODE=mock-local
EXPO_PUBLIC_API_BASE_URL=https://api.example.invalid
EXPO_PUBLIC_API_VERSION_PREFIX=/api/v1
# Stage 2 route default; override only if the server uses a different versioned route.
EXPO_PUBLIC_AUTH_REFRESH_PATH=/auth/refresh
